FROM python:3.12-slim
WORKDIR /srv/smcs
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HOME=/opt/hf ANONYMIZED_TELEMETRY=False
COPY requirements.meet.txt ./
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.11.0 \
    && pip install --no-cache-dir -r requirements.meet.txt
# Cache the selected embedding model at build time; runtime stays offline for embeddings.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-en-v1.5', device='cpu')"
COPY backend ./backend
COPY deployment/start-meet.sh ./deployment/start-meet.sh
RUN useradd --uid 10001 --create-home smcs \
    && mkdir -p /data && chown -R smcs:smcs /data
ENV ADMIN_STORAGE_DIR=/data HF_HUB_OFFLINE=1
USER smcs
EXPOSE 8000
CMD ["sh", "deployment/start-meet.sh"]
