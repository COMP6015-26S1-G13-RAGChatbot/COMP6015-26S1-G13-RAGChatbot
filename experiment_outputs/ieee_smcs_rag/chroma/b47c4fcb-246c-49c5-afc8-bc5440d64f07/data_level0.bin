:val="nil"/><w:left w:val="nil"/><w:bottom w:val="nil"/><w:right w:val="nil"/><w:between w:val="nil"/></w:pBdr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">President-Elect </w:t></w:r></w:p><w:p w14:paraId="00000021" w14:textId="77777777" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55"><w:pPr><w:pBdr><w:top w:val="nil"/><w:left w:val="nil"/><w:bottom w:val="nil"/><w:right w:val="nil"/><w:between w:val="nil"/></w:pBdr><w:ind w:left="880" w:firstLine="290"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:shd w:val="clear" w:color="auto" w:fill="B7B7B7"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> [See Constitution, Article VI, Section 3] </w:t></w:r></w:p><w:p w14:paraId="00000022" w14:textId="77777777" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="001766D3"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:sdt><w:sdtPr><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:tag w:val="goog_rdk_0"/><w:id w:val="1272716174"/></w:sdtPr><w:sdtEndPr/><w:sdtContent/></w:sdt><w:sdt><w:sdtPr><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:tag w:val="goog_rdk_1"/><w:id w:val="-1815121049"/></w:sdtPr><w:sdtEndPr/><w:sdtContent/></w:sdt><w:r w:rsidR="00043E55" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">Vice President for Organization and Planning  </w:t></w:r></w:p><w:p w14:paraId="45B00A87" w14:textId="5363BED8" w:rsidR="00925D8A" w:rsidRPr="006519E5" w:rsidRDefault="00925D8A" w:rsidP="00B73BB3"><w:pPr><w:ind w:left="1170"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>The Vice President for Organization and Planning, under the direction of the BoG, shall serve as Chair of the Organization and Planning Committee (OPC), providing leadership in guiding and coordinating the OPC in the development and updating of the Society’s strategic and tactical plans, the interpretation of the Constitution and Bylaws, and the preparation of modifications for BoG consideration. He/she shall ensure that the OPC fulfills its responsibilities as provided in the SMCS Bylaws [See Bylaws, Article III, Section 2], and represent the OPC’s recommendations to the BoG.</w:t></w:r></w:p><w:p w14:paraId="03B66E6D" w14:textId="77777777" w:rsidR="00925D8A" w:rsidRPr="006519E5" w:rsidRDefault="00925D8A" w:rsidP="00B73BB3"><w:pPr><w:ind w:left="1170"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr></w:p><w:p w14:paraId="00000024" w14:textId="77777777" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">Vice President for Systems Science and Engineering  </w:t></w:r></w:p><w:p w14:paraId="00000025" w14:textId="0E328789" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00752326" w:rsidP="00752326"><w:pPr><w:ind w:left="1134" w:firstLine="36"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>The Vice President for Systems Science and Engineering, under the direction of the BoG, shall serve as Chair of the Systems Science and Engineering Committee (SSEC), providing leadership in advancing the Society’s systems science and engineering activities.</w:t></w:r><w:r w:rsidR="00925D8A" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00925D8A" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">He/she shall ensure that the SSEC fulfills its responsibilities as provided in the SMCS Bylaws [See Bylaws, Article III, Section 3a], and </w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>represent the SSEC’s recommendations to the BoG</w:t></w:r><w:r w:rsidR="00925D8A" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="517EFD4C" w14:textId="77777777" w:rsidR="00156253" w:rsidRPr="006519E5" w:rsidRDefault="00156253" w:rsidP="00752326"><w:pPr><w:ind w:left="1134" w:firstLine="36"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:shd w:val="clear" w:color="auto" w:fill="B7B7B7"/></w:rPr></w:pPr></w:p><w:p w14:paraId="00000026" w14:textId="77777777" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">Vice President for Human Machine Systems </w:t></w:r></w:p><w:p w14:paraId="00000027" w14:textId="45D08B6F" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00973585" w:rsidP="00973585"><w:pPr><w:ind w:left="1170"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">The Vice President for Human–Machine Systems, under the direction of the BoG, shall serve as Chair of the Human–Machine Systems Committee (HMSC), providing leadership in advancing the Society’s human–machine systems activities. </w:t></w:r><w:r w:rsidR="00156253" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>He/she shall ensure that the HMSC fulfills its responsibilities as provided in the SMCS Bylaws [See Bylaws, Article III, Section 3b], and represent the HMSC’s recommendations to the BoG.</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="00000028" w14:textId="77777777" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">Vice President for Cybernetics </w:t></w:r></w:p><w:p w14:paraId="00000029" w14:textId="3DE90352" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="001B1B5C" w:rsidP="001B1B5C"><w:pPr><w:ind w:left="1170"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>The Vice President for Cybernetics, under the direction of the BoG, shall serve as Chair of the Cybernetics Committee (CC), providing leadership in advancing the Society’s cybernetics activities.</w:t></w:r><w:r w:rsidR="00156253" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> He/she shall ensure that the CC fulfills its responsibilities as provided in the SMCS Bylaws [See Bylaws, Article III, Section 3b], and represent the CC’s recommendations to the BoG.</w:t></w:r></w:p><w:p w14:paraId="0000002A" w14:textId="77777777" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Vice President for Publications</w:t></w:r></w:p><w:p w14:paraId="0000002B" w14:textId="41876EFD" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="001B1B5C" w:rsidP="001B1B5C"><w:pPr><w:ind w:left="1170"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">The Vice President for Publications, under the direction of the BoG, shall serve as Chair of the Publications Committee (PC), providing leadership in guiding and coordinating the </w:t></w:r><w:r w:rsidR="00925D8A" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>PC</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> in the formulation, evaluation, and execution of the Society’s publications policy and program. He/she shall ensure that the PC fulfills its responsibilities </w:t></w:r><w:r w:rsidR="00925D8A" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>as provided in the SMCS Bylaws [See Bylaws, Article III, Section 4]</w:t></w:r><w:r w:rsidR="00156253" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">, and </w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>represent the PC’s recommendations to the BoG</w:t></w:r><w:r w:rsidR="00925D8A" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="0000002C" w14:textId="77777777" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Vice President for Conferences and Meetings</w:t></w:r></w:p><w:p w14:paraId="0000002D" w14:textId="6C972D43" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00925D8A" w:rsidP="00925D8A"><w:pPr><w:ind w:left="1170"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>The Vice President for Conferences and Meetings, under the direction of the BoG, shall serve as Chair of the Conferences and Meetings Committee (CMC), providing leadership in guiding and coordinating the CMC in the planning, organization, and oversight of the Society’s conferences and meetings. He/she shall ensure that the CMC fulfills its responsibilities as provided in the SMCS Bylaws [See Bylaws, Article III, Section 5]</w:t></w:r><w:r w:rsidR="00156253" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">, and </w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">represent the CMC’s recommendations to the BoG. </w:t></w:r></w:p><w:p w14:paraId="0000002E" w14:textId="77777777" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">Vice President for Membership and Student Activities. </w:t></w:r></w:p><w:p w14:paraId="0000002F" w14:textId="77C0AA54" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00156253" w:rsidP="00156253"><w:pPr><w:ind w:left="1170"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">The Vice President for Membership and Student Activities, under the direction of the BoG, shall serve as Chair of the Membership and Student Activities Committee (MSAC), providing leadership in guiding and coordinating the MSAC in promoting membership growth, retention, and engagement, as well as supporting student activities and chapters. He/she shall ensure that the MSAC fulfills its responsibilities as provided in the SMCS Bylaws [See Bylaws, Article III, Section </w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsiaTheme="minorEastAsia" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>6</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>], and represent the MSAC’s recommendations to the BoG.</w:t></w:r></w:p><w:p w14:paraId="00000030" w14:textId="77777777" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">Vice President for Finance </w:t></w:r></w:p><w:p w14:paraId="00000031" w14:textId="77777777" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55"><w:pPr><w:ind w:left="1170"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>[See Bylaws, Article III, Section 7]</w:t></w:r></w:p><w:p w14:paraId="14CA5CC2" w14:textId="77777777" w:rsidR="00016CB4" w:rsidRPr="006519E5" w:rsidRDefault="00016CB4" w:rsidP="00016CB4"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:lastRenderedPageBreak/><w:t>Secretary</w:t></w:r></w:p><w:p w14:paraId="32552A89" w14:textId="77777777" w:rsidR="00016CB4" w:rsidRPr="006519E5" w:rsidRDefault="00016CB4" w:rsidP="00016CB4"><w:pPr><w:ind w:left="1170"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">[See Constitution, Article VI, Section 4] </w:t></w:r></w:p><w:p w14:paraId="06451FA1" w14:textId="77777777" w:rsidR="00016CB4" w:rsidRPr="006519E5" w:rsidRDefault="00016CB4" w:rsidP="00016CB4"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">Treasurer </w:t></w:r></w:p><w:p w14:paraId="24DB1491" w14:textId="77777777" w:rsidR="00016CB4" w:rsidRPr="006519E5" w:rsidRDefault="00016CB4" w:rsidP="00016CB4"><w:pPr><w:ind w:left="880" w:firstLine="290"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:shd w:val="clear" w:color="auto" w:fill="B7B7B7"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">[See Constitution, Article VI, Section 5] </w:t></w:r></w:p><w:p w14:paraId="00000032" w14:textId="17229874" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Associate Vice Presidents</w:t></w:r><w:r w:rsidR="00016CB4" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>, Secretary, and Treasurer</w:t></w:r></w:p><w:p w14:paraId="0999EC2D" w14:textId="57E336B2" w:rsidR="00016CB4" w:rsidRPr="006519E5" w:rsidRDefault="00016CB4" w:rsidP="00016CB4"><w:pPr><w:ind w:left="1170"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Associates to the Vice Presidents, Secretary, and Treasurer shall support their corresponding officers in carrying out the duties of their offices. They shall perform responsibilities as designated by the corresponding officer and shall report directly to him/her, in alignment with the SMCS Bylaws and policies. Associates may also represent their supervising officer in committee activities when so designated.</w:t></w:r></w:p><w:p w14:paraId="63886C2C" w14:textId="5EE2C840" w:rsidR="00016CB4" w:rsidRPr="006519E5" w:rsidRDefault="00016CB4"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">Executive </w:t></w:r><w:r w:rsidR="00E44DFC" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Assistant</w:t></w:r></w:p><w:p w14:paraId="3108A276" w14:textId="1722D2EB" w:rsidR="00016CB4" w:rsidRPr="006519E5" w:rsidRDefault="00E44DFC" w:rsidP="00E44DFC"><w:pPr><w:ind w:left="1170"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsiaTheme="minorEastAsia" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:bookmarkStart w:id="30" w:name="_Hlk207961833"/><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>The Executive Assistant shall support the President and President-Elect in advancing the Society’s mission and strategic objectives. The role includes</w:t></w:r><w:r w:rsidR="00FB5C46" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>,</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> but</w:t></w:r><w:r w:rsidR="00FB5C46" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> is not </w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>limited</w:t></w:r><w:r w:rsidR="00FB5C46" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> to,</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> coordinating with officers to ensure effective communication, maintaining records and documentation to strengthen governance, preparing reports as directed, and serving as a primary point of contact for designated Society functions.</w:t></w:r></w:p><w:bookmarkEnd w:id="30"/><w:p w14:paraId="18C0D5EA" w14:textId="77777777" w:rsidR="00E44DFC" w:rsidRPr="006519E5" w:rsidRDefault="00E44DFC" w:rsidP="00016CB4"><w:pPr><w:ind w:left="1170"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsiaTheme="minorEastAsia" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr></w:p><w:p w14:paraId="00000033" w14:textId="1AD11E69" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:ind w:left="1170" w:hanging="720"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">Member-at-Large </w:t></w:r></w:p><w:p w14:paraId="00000036" w14:textId="244D0C58" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00386CFF" w:rsidP="00386CFF"><w:pPr><w:ind w:left="1170"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Members-at-Large shall serve as elected members of the Board of Governors (BoG) with full voting rights and responsibilities. They shall represent the general membership in BoG deliberations and decisions, share collective responsibility for defining the Society’s direction, policies, and development, and may serve on committees or task forces as designated.</w:t></w:r></w:p><w:p w14:paraId="00000039" w14:textId="1529DF35" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr><w:pBdr><w:top w:val="nil"/><w:left w:val="nil"/><w:bottom w:val="nil"/><w:right w:val="nil"/><w:between w:val="nil"/></w:pBdr><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="000000"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="000000"/></w:rPr><w:t>Best Practices</w:t></w:r><w:r w:rsidR="00EF2D07" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> and</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> Operational </w:t></w:r><w:r w:rsidR="00EF2D07" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">Processes by </w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="000000"/></w:rPr><w:t>Area</w:t></w:r></w:p><w:p w14:paraId="0000003A" w14:textId="030B38F5" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55" w:rsidP="004F67C9"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="11"/></w:numPr><w:ind w:left="1157" w:hanging="709"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00EF2D07" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Operational</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> Execution of </w:t></w:r><w:r w:rsidR="00EF2D07" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">the </w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Constitution</w:t></w:r><w:r w:rsidR="00EF2D07" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> and Bylaws</w:t></w:r></w:p><w:p w14:paraId="0000003B" w14:textId="540FBC69" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55" w:rsidP="004F67C9"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="29"/></w:numPr><w:ind w:left="1576" w:hanging="442"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Officer Incapacity and Vacancy</w:t></w:r></w:p><w:p w14:paraId="0000003C" w14:textId="4B5D23B7" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55" w:rsidP="002F4947"><w:pPr><w:spacing w:before="240" w:after="240"/><w:ind w:left="1418"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>If a member of the Society</w:t></w:r><w:r w:rsidR="006D090C" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> leadership</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> is </w:t></w:r><w:r w:rsidR="000B64D3" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>unable</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> or </w:t></w:r><w:r w:rsidR="000B64D3" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>unwilling</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> to continue </w:t></w:r><w:r w:rsidR="000B64D3" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>p</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>erform</w:t></w:r><w:r w:rsidR="000B64D3" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>ing</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> their duties</w:t></w:r><w:r w:rsidR="000B64D3" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>,</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> the following steps </w:t></w:r><w:del w:id="31" w:author="Tom Gedeon" w:date="2026-04-02T16:29:00Z"><w:r w:rsidRPr="006519E5" w:rsidDel="0011443B"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:delText xml:space="preserve">will </w:delText></w:r></w:del><w:ins w:id="32" w:author="Tom Gedeon" w:date="2026-04-02T16:29:00Z"><w:r w:rsidR="0011443B"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>should</w:t></w:r><w:r w:rsidR="0011443B" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r></w:ins><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>be taken to ensure the position is filled</w:t></w:r><w:ins w:id="33" w:author="Tom Gedeon" w:date="2026-04-02T16:29:00Z"><w:r w:rsidR="0011443B"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> normally</w:t></w:r></w:ins><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr>