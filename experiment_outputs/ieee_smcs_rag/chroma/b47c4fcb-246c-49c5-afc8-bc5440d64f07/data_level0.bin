="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>www.ieee.org/petition</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:fldChar w:fldCharType="end"/></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r></w:ins><w:del w:id="40" w:author="Tom Gedeon" w:date="2026-04-02T16:32:00Z"><w:r w:rsidR="006D090C" w:rsidRPr="006519E5" w:rsidDel="0011443B"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:highlight w:val="yellow"/></w:rPr><w:delText>[paper petition is outdated]</w:delText></w:r></w:del></w:p><w:p w14:paraId="53721329" w14:textId="77777777" w:rsidR="006D090C" w:rsidRPr="006519E5" w:rsidRDefault="006D090C" w:rsidP="006D090C"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="1880"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr></w:p><w:p w14:paraId="00000072" w14:textId="329E38B4" w:rsidR="005C7B0B" w:rsidRPr="006519E5" w:rsidRDefault="00043E55" w:rsidP="004A3867"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="29"/></w:numPr><w:ind w:left="1576" w:hanging="442"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">ExCom/BOG Meetings and </w:t></w:r><w:r w:rsidR="006D090C" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Voting</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="5FD34A45" w14:textId="1E51DC88" w:rsidR="00372186" w:rsidRPr="006519E5" w:rsidRDefault="0011443B" w:rsidP="004A3867"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="11"/></w:numPr><w:ind w:left="1157" w:hanging="709"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:ins w:id="41" w:author="Tom Gedeon" w:date="2026-04-02T16:48:00Z"><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Specialty ‘</w:t></w:r></w:ins><w:commentRangeStart w:id="42"/><w:r w:rsidR="00043E55" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Technical</w:t></w:r><w:ins w:id="43" w:author="Tom Gedeon" w:date="2026-04-02T16:48:00Z"><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>’</w:t></w:r></w:ins><w:r w:rsidR="00043E55" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:commentRangeEnd w:id="42"/><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:commentReference w:id="42"/></w:r><w:r w:rsidR="00043E55" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Committees</w:t></w:r></w:p><w:p w14:paraId="00966858" w14:textId="77777777" w:rsidR="004B0549" w:rsidRPr="006519E5" w:rsidRDefault="004B0549" w:rsidP="004A3867"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="41"/></w:numPr><w:spacing w:line="276" w:lineRule="auto"/><w:ind w:left="1576" w:hanging="442"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Introduction</w:t></w:r></w:p><w:p w14:paraId="1ED3DF1D" w14:textId="72AC1A55" w:rsidR="001305E8" w:rsidRPr="006519E5" w:rsidRDefault="0011443B" w:rsidP="004A3867"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="200" w:after="200" w:line="276" w:lineRule="auto"/><w:ind w:left="1418"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:ins w:id="44" w:author="Tom Gedeon" w:date="2026-04-02T16:49:00Z"><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Specialty ‘</w:t></w:r></w:ins><w:r w:rsidR="004B0549" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Technical</w:t></w:r><w:ins w:id="45" w:author="Tom Gedeon" w:date="2026-04-02T16:49:00Z"><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>’</w:t></w:r></w:ins><w:r w:rsidR="004B0549" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> Committees (TCs)</w:t></w:r><w:r w:rsidR="005E28DA" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> are the core units</w:t></w:r><w:r w:rsidR="004B0549" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> of the IEEE SMCS technical activities, bringing together experts to advance research and applications in specialized domains. </w:t></w:r><w:r w:rsidR="005E28DA" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Each TC serves as a hub for research, development, and application within its field, and operates under defined leadership and oversight to ensure its effectiveness</w:t></w:r><w:r w:rsidR="001305E8" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="63FD2740" w14:textId="0C7C7CFE" w:rsidR="004B0549" w:rsidRPr="006519E5" w:rsidRDefault="00930FEA" w:rsidP="001305E8"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="200" w:after="200" w:line="276" w:lineRule="auto"/><w:ind w:left="1418"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Within the TC structure, governance is carried out through defined leadership bodies and oversight roles</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="SimSun" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="12C500A9" w14:textId="77777777" w:rsidR="00930FEA" w:rsidRPr="006519E5" w:rsidRDefault="00930FEA" w:rsidP="004A3867"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="55"/></w:numPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="200" w:after="200" w:line="276" w:lineRule="auto"/><w:ind w:left="1860" w:hanging="442"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr><w:t>Vice Presidents for Technical Activities (VPs-TA)</w:t></w:r></w:p><w:p w14:paraId="074C6A5F" w14:textId="77777777" w:rsidR="001305E8" w:rsidRPr="006519E5" w:rsidRDefault="001305E8" w:rsidP="00930FEA"><w:pPr><w:pStyle w:val="ListParagraph"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="200" w:after="200" w:line="276" w:lineRule="auto"/><w:ind w:left="2268"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="49CED359" w14:textId="2C63AF64" w:rsidR="00930FEA" w:rsidRPr="006519E5" w:rsidRDefault="00E97A05" w:rsidP="00930FEA"><w:pPr><w:pStyle w:val="ListParagraph"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="200" w:after="200" w:line="276" w:lineRule="auto"/><w:ind w:left="2268"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr><w:t>The VPs-TA shall provide executive leadership and operational oversight for all TCs. Their primary responsibilities are defined in detail in Sections 3.4-3.6 of this manual.</w:t></w:r></w:p><w:p w14:paraId="5BCD7018" w14:textId="77777777" w:rsidR="00E97A05" w:rsidRPr="006519E5" w:rsidRDefault="00E97A05" w:rsidP="00930FEA"><w:pPr><w:pStyle w:val="ListParagraph"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="200" w:after="200" w:line="276" w:lineRule="auto"/><w:ind w:left="2268"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="03B7DC1D" w14:textId="1DE4FEFB" w:rsidR="00E97A05" w:rsidRPr="006519E5" w:rsidDel="0011443B" w:rsidRDefault="00930FEA" w:rsidP="004A3867"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="55"/></w:numPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="200" w:after="200" w:line="276" w:lineRule="auto"/><w:ind w:left="1860" w:hanging="442"/><w:jc w:val="both"/><w:rPr><w:del w:id="46" w:author="Tom Gedeon" w:date="2026-04-02T16:49:00Z"/><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr></w:pPr><w:del w:id="47" w:author="Tom Gedeon" w:date="2026-04-02T16:49:00Z"><w:r w:rsidRPr="006519E5" w:rsidDel="0011443B"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr><w:delText>SMCS Technical Activities Board (SMCS-TAB)</w:delText></w:r></w:del><w:ins w:id="48" w:author="Tom Gedeon" w:date="2026-04-05T14:23:00Z"><w:r w:rsidR="002C494A"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="002C494A" w:rsidRPr="002C494A"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr><w:t xml:space="preserve">The corresponding Area Committees (CYBC, HMSC, and SSEC) shall discuss the request of creating a new TC or discontinuing an existing TC. They shall analyze the coverage of TCs within the </w:t></w:r><w:r w:rsidR="002C494A" w:rsidRPr="002C494A"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t>SMCS scope, discuss the necessity of creating new TCs and merging existing TCs, and support TC activities.</w:t></w:r></w:ins></w:p><w:p w14:paraId="21DCBDA2" w14:textId="1A848009" w:rsidR="001305E8" w:rsidRPr="006519E5" w:rsidDel="0011443B" w:rsidRDefault="001305E8" w:rsidP="00E97A05"><w:pPr><w:pStyle w:val="ListParagraph"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="200" w:after="200" w:line="276" w:lineRule="auto"/><w:ind w:left="2268"/><w:jc w:val="both"/><w:rPr><w:del w:id="49" w:author="Tom Gedeon" w:date="2026-04-02T16:49:00Z"/><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="020346DF" w14:textId="54403429" w:rsidR="00CB465B" w:rsidRPr="006519E5" w:rsidDel="0011443B" w:rsidRDefault="00E97A05" w:rsidP="00E97A05"><w:pPr><w:pStyle w:val="ListParagraph"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="200" w:after="200" w:line="276" w:lineRule="auto"/><w:ind w:left="2268"/><w:jc w:val="both"/><w:rPr><w:del w:id="50" w:author="Tom Gedeon" w:date="2026-04-02T16:49:00Z"/><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr></w:pPr><w:del w:id="51" w:author="Tom Gedeon" w:date="2026-04-02T16:49:00Z"><w:r w:rsidRPr="006519E5" w:rsidDel="0011443B"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr><w:delText>The SMCS-TAB shall be established to provide the formal approval, review, and high-level decisions of all TCs regarding their status.</w:delText></w:r><w:r w:rsidR="00CB465B" w:rsidRPr="006519E5" w:rsidDel="0011443B"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr><w:delText xml:space="preserve"> The President-Elect shall serve as the appointed Chair of the SMCS-TAB, and the three VPs-TA shall serve as members. </w:delText></w:r></w:del></w:p><w:p w14:paraId="0ED34F39" w14:textId="3E1DE355" w:rsidR="00CB465B" w:rsidRPr="006519E5" w:rsidDel="0011443B" w:rsidRDefault="00CB465B" w:rsidP="00E97A05"><w:pPr><w:pStyle w:val="ListParagraph"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="200" w:after="200" w:line="276" w:lineRule="auto"/><w:ind w:left="2268"/><w:jc w:val="both"/><w:rPr><w:del w:id="52" w:author="Tom Gedeon" w:date="2026-04-02T16:49:00Z"/><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="1ACC4609" w14:textId="313C0AE5" w:rsidR="00930FEA" w:rsidRPr="006519E5" w:rsidDel="0011443B" w:rsidRDefault="00CB465B" w:rsidP="00E97A05"><w:pPr><w:pStyle w:val="ListParagraph"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="200" w:after="200" w:line="276" w:lineRule="auto"/><w:ind w:left="2268"/><w:jc w:val="both"/><w:rPr><w:del w:id="53" w:author="Tom Gedeon" w:date="2026-04-02T16:49:00Z"/><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr></w:pPr><w:del w:id="54" w:author="Tom Gedeon" w:date="2026-04-02T16:49:00Z"><w:r w:rsidRPr="006519E5" w:rsidDel="0011443B"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr><w:delText>In years when there is no President-Elect, the Chair of the SMCS-TAB shall be appointed by the SMCS President. The appointed Chair may be selected from among the current VPs-TA or other qualified members of the Administrative Committee, ensuring continuity of leadership and alignment with the Society’s mission.</w:delText></w:r></w:del></w:p><w:p w14:paraId="399162A0" w14:textId="77777777" w:rsidR="00E97A05" w:rsidRPr="006519E5" w:rsidRDefault="00E97A05" w:rsidP="00E97A05"><w:pPr><w:pStyle w:val="ListParagraph"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="200" w:after="200" w:line="276" w:lineRule="auto"/><w:ind w:left="2268"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="69F2985E" w14:textId="61DC1D82" w:rsidR="00930FEA" w:rsidRPr="006519E5" w:rsidRDefault="00930FEA" w:rsidP="004A3867"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="55"/></w:numPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="200" w:after="200" w:line="276" w:lineRule="auto"/><w:ind w:left="1860" w:hanging="442"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr><w:t>TC Cha</w:t></w:r><w:r w:rsidR="00C707D2" w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr><w:t>ir</w:t></w:r></w:p><w:p w14:paraId="2CF37CE3" w14:textId="77777777" w:rsidR="001305E8" w:rsidRPr="006519E5" w:rsidRDefault="001305E8" w:rsidP="004A3867"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="2268"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="1FE1224B" w14:textId="1999663A" w:rsidR="00930FEA" w:rsidRPr="006519E5" w:rsidRDefault="00C707D2" w:rsidP="00C707D2"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="2268"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr><w:t>The TC Chair shall serve as the primary leader of the TC,</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> r</w:t></w:r><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:bCs/></w:rPr><w:t>esponsible for guiding its vision, coordinating activities, and acting as the principal liaison with the Society’s leadership</w:t></w:r></w:p><w:p w14:paraId="3A521853" w14:textId="77777777" w:rsidR="004B0549" w:rsidRPr="006519E5" w:rsidRDefault="004B0549" w:rsidP="00C707D2"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:after="0" w:line="276" w:lineRule="auto"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Times New Roman" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="404040"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7A7C0655" w14:textId="2E9065CF" w:rsidR="004B0549" w:rsidRPr="0011443B" w:rsidRDefault="004B0549" w:rsidP="004A3867"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="41"/></w:numPr><w:spacing w:line="276" w:lineRule="auto"/><w:ind w:left="1576" w:hanging="442"/><w:jc w:val="both"/><w:rPr><w:ins w:id="55" w:author="Tom Gedeon" w:date="2026-04-02T16:51:00Z"/><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:rPrChange w:id="56" w:author="Tom Gedeon" w:date="2026-04-02T16:51:00Z"><w:rPr><w:ins w:id="57" w:author="Tom Gedeon" w:date="2026-04-02T16:51:00Z"/><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:rPrChange></w:rPr></w:pPr><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">Creation of a </w:t></w:r><w:ins w:id="58" w:author="Tom Gedeon" w:date="2026-04-02T16:50:00Z"><w:r w:rsidR="0011443B"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Specialty ‘</w:t></w:r></w:ins><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Technical</w:t></w:r><w:ins w:id="59" w:author="Tom Gedeon" w:date="2026-04-02T16:50:00Z"><w:r w:rsidR="0011443B"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>’</w:t></w:r></w:ins><w:r w:rsidRPr="006519E5"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> Committee</w:t></w:r></w:p><w:p w14:paraId="54B2F4B6" w14:textId="7E0E10F5" w:rsidR="0011443B" w:rsidRPr="0011443B" w:rsidRDefault="0011443B" w:rsidP="0011443B"><w:pPr><w:numPr><w:ilvl w:val="2"/><w:numId w:val="41"/></w:numPr><w:spacing w:line="276" w:lineRule="auto"/><w:jc w:val="both"/><w:rPr><w:ins w:id="60" w:author="Tom Gedeon" w:date="2026-04-02T16:52:00Z"/><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:lang w:val="en-AU"/></w:rPr></w:pPr><w:ins w:id="61" w:author="Tom Gedeon" w:date="2026-04-02T16:51:00Z"><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>TCs will be formed by VPs</w:t></w:r></w:ins><w:ins w:id="62" w:author="Tom Gedeon" w:date="2026-04-02T16:52:00Z"><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> for </w:t></w:r></w:ins><w:ins w:id="63" w:author="Tom Gedeon" w:date="2026-04-02T16:53:00Z"><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>SS&amp;E/</w:t></w:r></w:ins><w:ins w:id="64" w:author="Tom Gedeon" w:date="2026-04-02T16:52:00Z"><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>HMS/</w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>C</w:t></w:r></w:ins><w:ins w:id="65" w:author="Tom Gedeon" w:date="2026-04-02T16:53:00Z"><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>yb</w:t></w:r></w:ins><w:proofErr w:type="spellEnd"/><w:ins w:id="66" w:author="Tom Gedeon" w:date="2026-04-02T16:52:00Z"><w:r w:rsidRPr="0011443B"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:lang w:val="en-AU"/></w:rPr><w:t xml:space="preserve">, including the appointment of chairs of such committees, subject to the provisions of Article III of the Bylaws </w:t></w:r></w:ins></w:p><w:p w14:paraId="749E8A91" w14:textId="7062C980" w:rsidR="0011443B" w:rsidRPr="006519E5" w:rsidRDefault="0011443B"><w:pPr><w:numPr><w:ilvl w:val="2"/><w:numId w:val="41"/></w:numPr><w:spacing w:line="276" w:lineRule="auto"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:pPrChange w:id="67" w:author="Tom Gedeon" w:date="2026-04-02T16:51:00Z"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="41"/></w:numPr><w:spacing w:line="276" w:lineRule="auto"/><w:ind w:left="1576" w:hanging="442"/><w:jc w:val="both"/></w:pPr></w:pPrChange></w:pPr></w:p><w:p w14:paraId="030BF773" 